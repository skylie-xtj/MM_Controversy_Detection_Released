ime": 1697198516}, "7290019517442310964": {"comments": "你教育资源好的地方当然支持双减那你想过那些落后的地方吗？不补课不加练拿什么去竞争呢？", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 2, "comments_reply": 10, "comments_time": 1697343832}, "7290758756131701515": {"comments": "一棒子打死不如规范化管理", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1697512059}, "7291254920803828543": {"comments": "为什么泉州这边还照样补习，福建教育局不举行上面的指示吗", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 1, "comments_time": 1697627580}, "7293758807225565990": {"comments": "黄赌毒仍然存在教育作为排在第四的应该也会存在", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1698210563}, "7299581061713101602": {"comments": "不从根源上解决问题，校外培训就一直有市场", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1699566178}, "7300194044357231372": {"comments": "抖音什么教学什么升学规划不算教培吗", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1699708882}}, "controversy": 1, "crawl_time": 1701064896.24921, "custom_verify": "", "enterprise_verify_reason": "", "forward_num": 160, "is_modified": 1, "keywords": "双减政策", "like_num": 514, "publish_time": 1695885060, "star_num": 233, "title": "补习班是真的上不了了，就连网课也没得上了，严令禁止，可以说是双减体系的最后一环#教培   #教育规划   #升学规划   #家长必读   #哈佛李老师升学规划", "url": "https://www.douyin.com/aweme/v1/play/?video_id=v0200fg10000ckaidg3c77u97l4qu3pg", "video_id": "7283770776866573625", "video_length": 246.966667}
{"author_follower": 127400, "author_like": 747449, "author_video": 500, "comment_num": 10489, "comments": {"6995883553162920704": {"comments": "说的很对，减少了作业，但没有减轻升学压力", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 2298, "comments_reply": 224, "comments_time": 1628856072}, "6996073477669831456": {"comments": "其实说到底，国家的减负政策就是找出真正有天赋孩子。我们要接受孩子的平凡，这是作为父母，最该具有的基本素养。我也觉得家长无需焦虑，因为谁都没办法说出十年后的中国是什么样子。[呲牙]", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 6733, "comments_reply": 764, "comments_time": 1628900295}, "6996136787945325348": {"comments": "你是在制造新的焦虑", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 93, "comments_reply": 16, "comments_time": 1628915034}, "6996372003159114530": {"comments": "我们小时候没有上培训班，不照样上211吗，主要还是要培养小孩自主学习的能力", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 213, "comments_reply": 61, "comments_time": 1628969818}, "6996441834352788255": {"comments": "学校不布置作业不等于家长也不布置作业，我家孩子一二年级学校没作业，回家我们给她作业，只要中考，高考不变，其他都是扯淡", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 674, "comments_reply": 74, "comments_time": 1628986061}, "6996485104990798627": {"comments": "重视教育的家庭在怎么减都会想办法往前冲 不重视教育的就算免费的补课他也觉得是浪费了他娃的休息时间 所以 懂得人自然懂[捂脸] [捂脸] 毕竟中高考还是要论分数排名的", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 60, "comments_reply": 6, "comments_time": 1628996132}, "6996909117847651106": {"comments": "为什么家长就不能接受自己的孩子普通与平凡呢？健康与幸福感就不应该重视一下吗？", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 696, "comments_reply": 271, "comments_time": 1629094855}, "6997829549312639748": {"comments": "虽然还是升学压力有，但是大环境改变，孩子还是那些孩子，利大于弊的是孩子得到解放，而且后期也会出台很多政策提高蓝领工资，白领蓝领地位相对持平，不知道家长还焦虑什么，这绝对是对大家好的政策。", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 64, "comments_reply": 26, "comments_time": 1629309173}, "6997926176539296547": {"comments": "影响作者的生意了[呲牙]", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 245, "comments_reply": 28, "comments_time": 1629331659}, "6998291711155946276": {"comments": "即使最后孩子要走上非常普通的工作岗位，我的想法也是让孩子接受到高等教育之后，再上岗，因为身边太多没接受过高等教育的成人，看问题的思维方式确实略差些，所以高等教育并不仅是好工作高收入的垫脚石，思维很重要", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 658, "comments_reply": 58, "comments_time": 1629416768}, "7002918348283478823": {"comments": "其实大家都补课，和大家都不补课，效果是一样的。因为升学率不变，大家都补课提升的是入学门槛分数线，不是升学率。而大家都不补课，升学率不变，那分数自然就低。补课和不补课是一模一样的。国家筛选的是天赋孩子", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 51, "comments_reply": 12, "comments_time": 1630493989}, "7003144914095571744": {"comments": "焦虑的是那些中产家庭，我们工薪家庭一直是顺其自然，36行行行出状元，孩子的身心健康最重要", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 91, "comments_reply": 12, "comments_time": 1630546741}, "7003382171243758370": {"comments": "努力是要靠自己的，不是靠补课机构的！从小培养好学习习惯，根本没必要花时间花金钱去补课", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 167, "comments_reply": 36, "comments_time": 1630601985}, "7004043938617803520": {"comments": "一、想努力的孩子不给努力的机会。\n二、还算有条件的孩子家庭不给利用这些条件。\n三、有天分的孩子不努力一定能优秀？\n四、不公布成绩，不公布排名，不知道学得怎样，会不会。结果大考都靠蒙？", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 62, "comments_reply": 11, "comments_time": 1630756060}, "7004764789465989920": {"comments": "对学霸和学渣根本没影响，影响最大的是成绩卡在中间那一些。", "comments_is_author_like": false, "comments_is_hot": true, "comments_like": 63, "comments_reply": 5, "comments_time": 1630923898}, "7140533731080930062": {"comments": "非常认同[赞][赞][赞]", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1662535072}, "7140907312756179747": {"comments": "一句讲晒：国家筛天赋+拔尖，冇天赋又唔服嘅就自己补拙咯", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1662622057}, "7141121738330391311": {"comments": "作业该多还是多", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1662672001}, "7141270622495687458": {"comments": "高考越来越难  就是为了筛选 更考验的是父母", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1662706646}, "7141459925973336846": {"comments": "我女儿三年级，现在学校要上延时课，她自身问题比较多，学习习惯不好，精力不集中，每天回来5.30，回来作业写到8.9点，没有一个活动时间。也没有写课外作业的时间，这种情况你觉得有必要上延时课嘛", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1662750777}, "7142008270512096014": {"comments": "感觉我们这没啥变化，老师依然抓得紧，大家依然你追我赶的各种补课", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 1, "comments_reply": 0, "comments_time": 1662878389}, "7142164373862990632": {"comments": "最可恨的就是一些家长，一边高举大旗喊双减，一边偷偷给孩子加补习，这样竞争就少了很多。", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 1, "comments_reply": 0, "comments_time": 1662914757}, "7143142807569564416": {"comments": "我跟女儿说，不要求考清华北大，哪怕考个老师，医生也行呀，一定要保持到年级前10，才能考上高中，我会一直陪着她，引导他，督促她，\n我们约好，她考上好大学，带着我们出去看看外面的世界，去旅游[色][色]", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1663142550}, "7143145270729229063": {"comments": "自己小时候也是做作业出来的啊！！！！课上就做好作业了！其他时间就是做其他课外的了[捂脸][捂脸][捂脸]", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1663143122}, "7143156464604480288": {"comments": "中高考出什么题型、难度，决定老师平时的教学方式", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1663145725}, "7143610809028264718": {"comments": "说的有道理  升学压力还是那么大的 [捂脸] 大家还是很卷", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comments_reply": 0, "comments_time": 1663251507}, "7146836660210615070": {"comments": "建议取消家长群", "comments_is_author_like": false, "comments_is_hot": false, "comments_like": 0, "comment